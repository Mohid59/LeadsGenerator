# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# n8n basic-auth credentials (used to log in to the web UI)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_to_a_strong_random_password

# ngrok auth token — get one free at https://ngrok.com → Your Authtoken
# Only needed if running `docker compose --profile tunnel up -d`
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
